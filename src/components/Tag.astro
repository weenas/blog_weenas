---
import { getRelativeLocaleUrl } from "astro:i18n";
import chuanliuMark from "@/assets/icons/chuanliu-avatar-256.png";
import config from "@/config";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
};

const { tag, tagName, size = "lg" } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
---

<li>
  <a
    href={getRelativeLocaleUrl(locale, `tags/${tag}/`)}
    transition:name={tag}
    class:list={[
      "bg-accent/10 text-accent flex items-center gap-0.5 rounded-full font-medium transition-colors",
      "hover:bg-accent hover:text-accent-foreground",
      { "px-3 py-1 text-sm": size === "sm" },
      { "px-4 py-1.5": size === "lg" },
    ]}
  >
    <img
      src={chuanliuMark.src}
      alt=""
      class:list={[
        "shrink-0 object-contain",
        { "size-4": size === "lg" },
        { "size-3.5": size === "sm" },
      ]}
    />
    {tagName}
  </a>
</li>
