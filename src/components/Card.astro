---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { toTransitionName } from "@/utils/toTransitionName";
import { getAssetPath } from "@/utils/withBase";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"posts">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, image, ...props } = data;
---

<li
  class="card group hover:border-accent relative flex gap-4 p-4 hover:-translate-y-0.5 sm:gap-6 sm:p-5"
>
  <div class="min-w-0 flex-1">
    <Heading
      transition:name={toTransitionName(id)}
      class="text-foreground group-hover:text-accent text-lg leading-snug font-semibold transition-colors"
    >
      <a
        href={getPostUrl(id, filePath, Astro.currentLocale)}
        class="focus-visible:no-underline"
      >
        <!-- The whole card is clickable. -->
        <span class="absolute inset-0 rounded-2xl" aria-hidden="true"></span>
        {title}
      </a>
    </Heading>
    <Datetime {...props} class="mt-2" />
    <p class="text-muted-foreground mt-2 line-clamp-3 text-[0.95rem]">
      {description}
    </p>
  </div>

  <div
    class="border-border bg-accent/5 aspect-[16/10] w-24 shrink-0 self-start overflow-hidden rounded-xl border sm:w-40"
  >
    {
      image ? (
        <img
          src={image}
          alt=""
          width="160"
          height="100"
          loading="lazy"
          decoding="async"
          class="size-full object-cover transition-transform duration-300 group-hover:scale-105"
        />
      ) : (
        <img
          src={getAssetPath("images/chuanliu-avatar.webp")}
          alt=""
          width="512"
          height="512"
          loading="lazy"
          decoding="async"
          class="size-full object-cover"
        />
      )
    }
  </div>
</li>
