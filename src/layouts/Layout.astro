---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { getRelativeLocaleUrl } from "astro:i18n";
import { resolveDefaultOgImagePath } from "@/utils/resolveDefaultOgImagePath";
import { getAssetPath, stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import {
  DEFAULT_LOCALE,
  LOCALES,
  LOCALE_META,
  toLocale,
  type Locale,
} from "@/i18n/locales";
import config from "@/config";
import "@/styles/global.css";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  ogType?: "website" | "article";
  /** Keep the page out of search results (search page, 404). */
  noindex?: boolean;
  /**
   * Languages this page really exists in (default: all). A page shown in a
   * language it lacks points its canonical at the first available one.
   */
  locales?: Locale[];
};

const { site } = config;

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);

const {
  title = site.title,
  description = t.site.description,
  ogImage = resolveDefaultOgImagePath(config),
  canonicalURL: canonicalProp,
  ogType = "website",
  noindex = false,
  locales = [...LOCALES],
} = Astro.props;

const socialImageURL = new URL(ogImage, Astro.site ?? Astro.url);
// RSS is only generated in the default locale, and it has no trailing slash.
const rssHref = getAssetPath("rss.xml");

// Same page in every language, for <link rel="alternate" hreflang>.
const pagePath = stripLocale(stripBase(Astro.originPathname), locale).replace(
  /^\//,
  ""
);
const localeUrl = (l: Locale) =>
  new URL(getRelativeLocaleUrl(l, pagePath), Astro.site).href;

const alternates = locales.map(alt => ({
  hreflang: LOCALE_META[alt].htmlLang,
  href: localeUrl(alt),
}));
const defaultAlternate =
  alternates.length > 1
    ? localeUrl(locales.includes(DEFAULT_LOCALE) ? DEFAULT_LOCALE : locales[0])
    : undefined;

const canonicalURL =
  canonicalProp ??
  (locales.includes(locale)
    ? new URL(Astro.originPathname, Astro.site).href
    : localeUrl(locales[0]));

const ogLocale = (l: Locale) => LOCALE_META[l].htmlLang.replace("-", "_");

// Site-wide structured data on the home page of each language.
const isHome = pagePath === "";
const websiteData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.title,
  description: t.site.description,
  url: new URL(getRelativeLocaleUrl(locale, ""), Astro.site).href,
  inLanguage: LOCALE_META[locale].htmlLang,
  author: {
    "@type": "Person",
    name: site.author,
    ...(site.profile && { url: site.profile }),
  },
};
---

<!doctype html>
<html
  dir={site.dir ?? "ltr"}
  lang={LOCALE_META[locale].htmlLang}
  class="overflow-y-scroll scroll-smooth"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={getAssetPath("favicon.svg")} />
    <link rel="canonical" href={canonicalURL} />
    {
      alternates.length > 1 &&
        alternates.map(({ hreflang, href }) => (
          <link rel="alternate" {hreflang} {href} />
        ))
    }
    {
      defaultAlternate && (
        <link rel="alternate" hreflang="x-default" href={defaultAlternate} />
      )
    }
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="generator" content={Astro.generator} />

    <!-- Font -->
    <Font
      cssVariable="--font-google-sans-code"
      preload={[{ subset: "latin", weight: 400, style: "normal" }]}
    />

    <!-- Primary meta -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <link rel="sitemap" href={getAssetPath("sitemap-index.xml")} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale(locale)} />
    {
      LOCALES.filter(alt => alt !== locale).map(alt => (
        <meta property="og:locale:alternate" content={ogLocale(alt)} />
      ))
    }
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <!-- RSS autodiscovery -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.title}
      href={new URL(rssHref, Astro.site)}
    />

    <!-- Filled at runtime by theme.ts to match the current background colour -->
    <meta name="theme-color" content="" />

    {
      isHome && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(websiteData)}
        />
      )
    }

    <!-- Extra head content injected by child layouts (e.g. JSON-LD, article meta) -->
    <slot name="head" />

    {
      site.googleVerification && (
        <meta
          name="google-site-verification"
          content={site.googleVerification}
        />
      )
    }

    <!--
      Inline FOUC-prevention script: sets data-theme on <html> before
      the browser paints. Runs synchronously, no defer/async.
    -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        const theme = stored ?? (prefersDark ? "dark" : "light");
        const root = document.firstElementChild;
        root?.setAttribute("data-theme", theme);
        root?.classList.toggle("dark", theme === "dark");
        // Expose value so theme.ts can skip re-detection.
        window.__theme = { value: theme };
      })();
    </script>

    <ClientRouter />
  </head>
  <body
    class="bg-background font-app text-foreground selection:bg-accent/75 selection:text-accent-foreground flex min-h-svh flex-col"
  >
    <slot />
    <script>
      import "@/scripts/theme";
    </script>
  </body>
</html>
