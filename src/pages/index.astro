---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import { toLocale } from "@/i18n/locales";
import { localizePosts } from "@/utils/postLocale";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);

const posts = localizePosts(await getCollection("posts"), locale);
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout"
  >
    <section id="hero" class="relative isolate pt-14 pb-10 sm:pt-20 sm:pb-14">
      <!-- Soft brand glow behind the intro, as on weenas.com -->
      <div
        aria-hidden="true"
        class="hero-glow pointer-events-none absolute inset-x-0 -top-10 -z-10 h-80"
      >
      </div>
      <p class="text-accent mb-3 text-sm font-semibold tracking-wide">
        {t.home.heroEyebrow}
      </p>
      <h1
        class="max-w-[16em] text-4xl leading-tight font-bold tracking-tight text-balance sm:text-5xl"
      >
        {t.home.heroTitle}
      </h1>
      <p class="text-muted-foreground mt-5 max-w-[34em] text-lg">
        {t.home.heroLead}
      </p>
      <div class="mt-7 flex flex-wrap items-center gap-3">
        {
          socials.length > 0 && (
            <div class="flex items-center">
              <span class="sr-only">{t.home.socialLinks}</span>
              <Socials />
            </div>
          )
        }
        <a
          href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
          target="_blank"
          class="btn-ghost"
        >
          <IconRss class="size-4" />
          RSS
        </a>
      </div>
    </section>

    {
      featuredPosts.length > 0 && (
        <section id="featured" class="pb-10">
          <h2 class="mb-5 text-2xl font-bold tracking-tight">
            {t.home.featured}
          </h2>
          <ul class="grid gap-4">
            {featuredPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pb-6">
          <h2 class="mb-5 text-2xl font-bold tracking-tight">
            {t.home.recentPosts}
          </h2>
          <ul class="grid gap-4">
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton
        href={getRelativeLocaleUrl(locale, "posts")}
        class="btn-ghost"
      >
        {t.home.allPosts}
        <IconArrowRight class="inline-block size-4 rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
