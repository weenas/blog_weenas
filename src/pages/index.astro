---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Datetime from "@/components/Datetime.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyStr } from "@/utils/slugify";
import { useTranslations } from "@/i18n";
import { toLocale } from "@/i18n/locales";
import { localizePosts } from "@/utils/postLocale";
import config from "@/config";

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const posts = getSortedPosts(
  localizePosts(await getCollection("posts"), locale)
);
const visiblePosts = posts.slice(0, config.posts.perIndex);
const tagCounts = new Map<string, { name: string; count: number }>();
for (const post of posts) {
  for (const name of post.data.tags) {
    const slug = slugifyStr(name);
    const existing = tagCounts.get(slug);
    if (existing) existing.count += 1;
    else tagCounts.set(slug, { name, count: 1 });
  }
}
const tags = [...tagCounts.entries()]
  .sort((a, b) => b[1].count - a[1].count)
  .slice(0, 12);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header hideAboutAndArchives />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="home-page"
  >
    <section class="home-banner" aria-labelledby="home-title">
      <img
        src="https://img.weenas.com/optimized/lake-banner-bright-preview-20261103.webp"
        alt=""
        width="1800"
        height="811"
        fetchpriority="high"
        decoding="async"
      />
      <div class="banner-shade"></div>
      <div class="banner-copy">
        <p>TECHNOLOGY &amp; LIFE</p>
        <h1 id="home-title">川流不息</h1>
        <span>记录技术、生活与路上的风景</span>
      </div>
    </section>

    <div class="home-content">
      <aside class="sidebar" aria-label="博客信息">
        <section class="side-card profile-card">
          <div class="profile-cover"></div>
          <img
            class="profile-avatar"
            src={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}images/chuanliu-avatar.webp`}
            alt=""
            width="88"
            height="88"
          />
          <h2>川流不息</h2>
          <p>{t.home.heroLead}</p>
          <div class="profile-stats">
            <a href={getRelativeLocaleUrl(locale, "posts/")}
              ><strong>{posts.length}</strong><span>文章</span></a
            >
            <a href={getRelativeLocaleUrl(locale, "tags/")}
              ><strong>{tagCounts.size}</strong><span>标签</span></a
            >
          </div>
          <div class="socials"><Socials /></div>
        </section>
        <section class="side-card tags-card">
          <h2>
            常用标签 <a href={getRelativeLocaleUrl(locale, "tags/")}>全部 ↗</a>
          </h2>
          <div class="tag-list">
            {
              tags.map(([slug, tag]) => (
                <a href={getRelativeLocaleUrl(locale, `tags/${slug}/`)}>
                  <>
                    <span># {tag.name}</span>
                    <small>{tag.count}</small>
                  </>
                </a>
              ))
            }
          </div>
        </section>
      </aside>

      <section class="posts-column" aria-labelledby="posts-heading">
        <div class="section-title">
          <div><p>记录与分享</p><h2 id="posts-heading">最新文章</h2></div><a
            href={getRelativeLocaleUrl(locale, "posts/")}
            >全部文章 <span>→</span></a
          >
        </div>
        <div class="post-list">
          {
            visiblePosts.map(post => (
              <article
                class:list={["post-card", { "no-cover": !post.data.image }]}
              >
                <div class="post-copy">
                  <div class="post-meta">
                    <>
                      <Datetime {...post.data} />
                      <span>·</span>
                      <span>{post.data.tags[0] ?? "笔记"}</span>
                    </>
                  </div>
                  <h3>
                    <a href={getPostUrl(post.id, post.filePath, locale)}>
                      {post.data.title}
                    </a>
                  </h3>
                  <p>{post.data.description}</p>
                  <div class="post-tags">
                    {post.data.tags.slice(0, 3).map(tag => (
                      <span># {tag}</span>
                    ))}
                  </div>
                </div>
                {post.data.image && (
                  <a
                    class="post-image"
                    href={getPostUrl(post.id, post.filePath, locale)}
                    aria-label={`阅读 ${post.data.title}`}
                  >
                    <img
                      src={post.data.image}
                      alt=""
                      width="440"
                      height="280"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                )}
              </article>
            ))
          }
        </div>
        <a class="all-posts" href={getRelativeLocaleUrl(locale, "posts/")}
          >查看全部文章 <span>→</span></a
        >
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout)
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
  });
</script>

<style>
  .home-page {
    --home-bg: #f1f5f8;
    --home-card: #fff;
    --home-text: #23354b;
    --home-muted: #718197;
    --home-accent: #168fa3;
    background: var(--home-bg);
    color: var(--home-text);
    min-height: 100vh;
    padding-bottom: 5rem;
  }
  :global([data-theme="dark"]) .home-page {
    --home-bg: #101b2b;
    --home-card: #1b293a;
    --home-text: #e9eff6;
    --home-muted: #a0afc1;
    --home-accent: #5ac9d1;
  }
  .home-banner {
    height: 330px;
    position: relative;
    overflow: hidden;
    background: #244d64;
  }
  .home-banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 48%;
  }
  .banner-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(8, 30, 48, 0.42), rgba(8, 30, 48, 0.04) 72%),
      linear-gradient(0deg, rgba(7, 25, 42, 0.12), transparent 70%);
  }
  .banner-copy {
    position: absolute;
    inset: 0;
    max-width: 1100px;
    margin: auto;
    padding: 2rem 2rem 4rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: #fff;
    text-shadow: 0 2px 18px #102b3d80;
  }
  .banner-copy p {
    font-size: 0.72rem;
    letter-spacing: 0.23em;
    font-weight: 700;
    opacity: 0.8;
  }
  .banner-copy h1 {
    font-size: clamp(2.7rem, 5vw, 4rem);
    font-weight: 750;
    letter-spacing: 0.06em;
    margin: 0.35rem 0 0.25rem;
  }
  .banner-copy span {
    font-size: 1rem;
    opacity: 0.95;
  }
  .home-content {
    position: relative;
    max-width: 1100px;
    margin: -3rem auto 0;
    padding: 0 1.5rem;
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: 1.35rem;
    align-items: start;
  }
  .sidebar,
  .posts-column {
    min-width: 0;
  }
  .sidebar {
    display: grid;
    gap: 1rem;
  }
  .side-card,
  .post-card {
    background: var(--home-card);
    border-radius: 20px;
    box-shadow: 0 8px 30px #1d415008;
    overflow: hidden;
  }
  .profile-card {
    text-align: center;
    padding: 0 1.35rem 1.25rem;
  }
  .profile-cover {
    height: 72px;
    margin: 0 -1.35rem;
    background: linear-gradient(120deg, #99d5db, #7fb6d1 52%, #b8dfe1);
  }
  .profile-avatar {
    position: relative;
    width: 88px;
    height: 88px;
    margin: -44px auto 0.75rem;
    padding: 10px;
    border: 5px solid var(--home-card);
    border-radius: 50%;
    background: var(--home-card);
    object-fit: contain;
  }
  .profile-card h2 {
    font-size: 1.25rem;
    font-weight: 750;
  }
  .profile-card p {
    color: var(--home-muted);
    font-size: 0.83rem;
    line-height: 1.8;
    margin: 0.55rem 0 1rem;
  }
  .profile-stats {
    display: flex;
    justify-content: center;
    gap: 2.8rem;
    margin: 0.3rem 0 0.8rem;
  }
  .profile-stats a {
    display: grid;
    gap: 0.1rem;
    text-decoration: none;
  }
  .profile-stats strong {
    font-size: 1.1rem;
  }
  .profile-stats span {
    color: var(--home-muted);
    font-size: 0.75rem;
  }
  .socials {
    display: flex;
    justify-content: center;
    color: var(--home-accent);
  }
  .tags-card {
    padding: 1.25rem;
  }
  .tags-card h2 {
    font-size: 0.94rem;
    font-weight: 750;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .tags-card h2 a {
    font-size: 0.7rem;
    color: var(--home-muted);
    text-decoration: none;
    font-weight: 500;
  }
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .tag-list a {
    background: color-mix(in srgb, var(--home-accent) 9%, transparent);
    color: var(--home-accent);
    border-radius: 9px;
    padding: 0.35rem 0.5rem;
    text-decoration: none;
    font-size: 0.72rem;
    display: flex;
    gap: 0.4rem;
  }
  .tag-list small {
    opacity: 0.7;
  }
  .section-title {
    padding: 0.4rem 0.2rem 0.85rem;
    display: flex;
    justify-content: space-between;
    align-items: end;
  }
  .section-title p {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--home-accent);
    letter-spacing: 0.12em;
  }
  .section-title h2 {
    margin: 0.25rem 0 0;
    font-size: 1.3rem;
    font-weight: 750;
  }
  .section-title > a {
    font-size: 0.8rem;
    color: var(--home-muted);
    text-decoration: none;
  }
  .section-title > a span {
    color: var(--home-accent);
    margin-left: 0.25rem;
  }
  .post-list {
    display: grid;
    gap: 1rem;
  }
  .post-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 36%;
    min-height: 186px;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }
  .post-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 35px #24485c18;
  }
  .post-card.no-cover {
    grid-template-columns: 1fr;
  }
  .post-copy {
    display: flex;
    flex-direction: column;
    align-items: start;
    padding: 1.45rem 1.6rem;
    min-width: 0;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    color: var(--home-accent);
    font-size: 0.72rem;
    font-weight: 650;
  }
  .post-meta :global(svg) {
    width: 14px;
    height: 14px;
  }
  .post-card h3 {
    margin: 0.65rem 0 0.45rem;
    font-size: 1.14rem;
    line-height: 1.5;
    font-weight: 750;
  }
  .post-card h3 a {
    color: var(--home-text);
    text-decoration: none;
  }
  .post-card h3 a:hover {
    color: var(--home-accent);
  }
  .post-copy > p {
    color: var(--home-muted);
    font-size: 0.83rem;
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: auto;
    padding-top: 0.8rem;
    color: var(--home-muted);
    font-size: 0.7rem;
  }
  .post-image {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 100%;
    overflow: hidden;
    background: color-mix(in srgb, var(--home-accent) 6%, var(--home-card));
  }
  .post-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .all-posts {
    display: flex;
    justify-content: center;
    gap: 0.7rem;
    margin-top: 1.1rem;
    padding: 0.95rem;
    border-radius: 16px;
    background: var(--home-card);
    color: var(--home-accent);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 700;
  }
  @media (max-width: 800px) {
    .home-content {
      grid-template-columns: 1fr;
      max-width: 720px;
    }
    .sidebar {
      grid-template-columns: 1fr 1fr;
    }
    .profile-card {
      padding-bottom: 1rem;
    }
    .profile-card p {
      max-width: 26rem;
      margin-left: auto;
      margin-right: auto;
    }
  }
  @media (max-width: 560px) {
    .home-banner {
      height: 260px;
    }
    .banner-copy {
      padding: 1.5rem 1.5rem 3.5rem;
    }
    .home-content {
      padding: 0 1rem;
      margin-top: -2.4rem;
    }
    .sidebar {
      grid-template-columns: 1fr;
    }
    .tags-card {
      display: none;
    }
    .profile-cover {
      height: 56px;
    }
    .profile-avatar {
      width: 72px;
      height: 72px;
      margin-top: -36px;
    }
    .profile-card p {
      margin: 0.3rem auto 0.55rem;
    }
    .profile-stats {
      margin: 0.3rem 0;
    }
    .post-card {
      grid-template-columns: 1fr 34%;
      min-height: 155px;
    }
    .post-copy {
      padding: 1rem;
    }
    .post-card h3 {
      font-size: 0.98rem;
    }
    .post-copy > p {
      font-size: 0.75rem;
    }
    .post-tags {
      display: none;
    }
  }
</style>
